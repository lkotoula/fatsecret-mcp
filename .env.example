# FatSecret API Credentials (required)
FATSECRET_CONSUMER_KEY=your_consumer_key_here
FATSECRET_CONSUMER_SECRET=your_consumer_secret_here

# FatSecret User Tokens (set after first OAuth authorization)
FATSECRET_ACCESS_TOKEN=
FATSECRET_TOKEN_SECRET=

# Server Configuration
MCP_TRANSPORT=streamable_http
MCP_PORT=8000
